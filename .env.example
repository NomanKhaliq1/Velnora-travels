# Public URL of the site, used for metadata, the sitemap and share links
SITE_URL=http://localhost:3000

# Admin login
ADMIN_EMAIL=admin@velnoratravels.com
# Generate with: npm run admin:hash -- "your-password"
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
